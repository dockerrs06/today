{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "dev-adf-env-001"
		},
		"destination_ds_properties_parameters_folderName_defaultValue": {
			"type": "string",
			"defaultValue": "source"
		},
		"destination_ds_properties_parameters_fileName_defaultValue": {
			"type": "string",
			"defaultValue": "employee_data_dev.csv"
		},
		"source_ds_properties_parameters_folderName_defaultValue": {
			"type": "string",
			"defaultValue": "source"
		},
		"source_ds_properties_parameters_fileName_defaultValue": {
			"type": "string",
			"defaultValue": "employee_data_dev.csv"
		},
		"dev_ls_properties_typeProperties_serviceEndpoint": {
			"type": "string",
			"defaultValue": "https://devstaccouint.blob.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "dev-adf-env-001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"dev_ls_properties_typeProperties_serviceEndpoint": {
						"value": "[parameters('dev_ls_properties_typeProperties_serviceEndpoint')]"
					},
					"destination_ds_properties_parameters_folderName_defaultValue": {
						"value": "[parameters('destination_ds_properties_parameters_folderName_defaultValue')]"
					},
					"destination_ds_properties_parameters_fileName_defaultValue": {
						"value": "[parameters('destination_ds_properties_parameters_fileName_defaultValue')]"
					},
					"source_ds_properties_parameters_folderName_defaultValue": {
						"value": "[parameters('source_ds_properties_parameters_folderName_defaultValue')]"
					},
					"source_ds_properties_parameters_fileName_defaultValue": {
						"value": "[parameters('source_ds_properties_parameters_fileName_defaultValue')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}