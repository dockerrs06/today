{
	"name": "source_ds",
	"properties": {
		"linkedServiceName": {
			"referenceName": "dev_ls",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"folderName": {
				"type": "string",
				"defaultValue": "source"
			},
			"fileName": {
				"type": "string",
				"defaultValue": "employee_data_dev.csv"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobStorageLocation",
				"fileName": "@dataset().fileName",
				"container": "@dataset().folderName"
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": []
	}
}